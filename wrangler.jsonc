{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prismfinance",
  "main": "worker/src/site.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://frosty-night-150d.cloudflareaccess.com",
    "ACCESS_AUD": "71e4e20c6b3a9ed4b1ece9bf2e510bd0fb1a328b4abd5c5e8b81344141f8a48b",
    "SUPABASE_URL": "https://gsvfzjuktwowliycqvpw.supabase.co",
    "PLAID_CLIENT_ID": "6accf4e74fa127000d24be55",
    "PLAID_ENV": "sandbox"
  },
  // Stage: separate Worker, separate Supabase project, Plaid Sandbox, Tradier sandbox. Shares nothing with production.
  // Fill SUPABASE_URL and ACCESS_AUD after creating the Stage project and Access app (see STAGE.md). Until then it refuses all requests (503).
  "env": {
    "stage": {
      "name": "prismfinance-stage",
      "main": "worker/src/site.ts",
      "workers_dev": true,
      "preview_urls": false,
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://frosty-night-150d.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "SUPABASE_URL": "",
        "PLAID_CLIENT_ID": "6accf4e74fa127000d24be55",
        "PLAID_ENV": "sandbox",
        "TRADIER_ENV": "sandbox"
      }
    }
  }
}
